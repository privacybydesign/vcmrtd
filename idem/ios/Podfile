# Regula publishes only older FaceSDK/FaceCoreBasic releases to the CocoaPods
# trunk; current ones (the versions flutter_face_api and flutter_face_core_basic
# pin) live in their own spec repo. Declaring any source disables the implicit
# trunk default, so trunk has to be listed explicitly alongside it. Trunk is
# referenced by its CDN rather than the CocoaPods/Specs git mirror the vendor's
# own example Podfile uses, to avoid cloning a multi-gigabyte repository.
source 'https://cdn.cocoapods.org/'
source 'https://github.com/regulaforensics/podspecs.git'

# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # No explicit TensorFlowLiteC pod here. It used to be required so tflite_flutter
  # could dlsym the TFLite C API symbols, but face_verification now depends on
  # flutter_litert, whose podspec vendors TensorFlowLiteC.xcframework (plus the
  # Metal, CoreML and LiteRt frameworks) itself. Adding the trunk pod as well
  # gives Pods-Runner two frameworks with the same name and the install fails.

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Google's GoogleMLKit/* pods ship no arm64-iphonesimulator slice and force
  # EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64 onto the Runner target, which
  # since Xcode 26 dropped Rosetta leaves no buildable simulator destination.
  # google_mlkit_commons ships an opt-in helper that relabels the arm64 slice's
  # LC_BUILD_VERSION.platform per build -- iOS Simulator for simulator builds,
  # iOS for device builds -- and strips the exclusion. One pod install serves
  # both. Upstream: https://issuetracker.google.com/issues/178965151
  #
  # Required here rather than at the top of the Podfile as the plugin's README
  # suggests: .symlinks/plugins is created by flutter_install_all_ios_pods in
  # the target block above, so a top-level require fails on a clean checkout.
  require File.expand_path(
    '.symlinks/plugins/google_mlkit_commons/ios/scripts/apple_silicon_simulator',
    __dir__,
  )
  mlkit_apple_silicon_simulator_patch(installer)
end
